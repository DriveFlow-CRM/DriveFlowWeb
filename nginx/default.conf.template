# Nginx configuration template for Angular SPA + Certbot + optional API proxy
# Values are injected from environment variables via envsubst in entrypoint.

# HTTP server: serve ACME challenge and redirect to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ${FRONTEND_DOMAIN};

    # Serve ACME http-01 challenges
    location /.well-known/acme-challenge/ {
        alias /var/www/certbot/.well-known/acme-challenge/;
    }

    # Redirect everything else to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS server: serve SPA and proxy API
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${FRONTEND_DOMAIN};

    # TLS certs from Certbot
    ssl_certificate /etc/letsencrypt/live/${FRONTEND_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${FRONTEND_DOMAIN}/privkey.pem;

    # Recommended SSL settings (simplified)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Allow large assets
    client_max_body_size 10m;

    # Serve static Angular build
    root /usr/share/nginx/html;
    index index.html;

    # API reverse proxy (optional) — enabled when BACKEND_URL is set
    # Proxies paths starting with /api to your backend
    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass ${BACKEND_URL};
        proxy_redirect off;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}


