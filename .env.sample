# Required - Used by Docker/deployment scripts
BACKEND_URL=https://api.driveflow.com/api/
FRONTEND_DOMAIN=app.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Optional
USE_STAGING=false

# Note: For Angular app configuration, update one of:
# 1. src/app/core/services/config.service.ts (DEFAULT_API_URL)
# 2. src/index.html (window.__APP_CONFIG__.apiBaseUrl)
